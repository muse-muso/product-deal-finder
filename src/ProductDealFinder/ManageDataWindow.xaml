<Window x:Class="ProductDealFinder.ManageDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Products and History" Height="600" Width="1000">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Products &amp; Thresholds">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="Refresh" Width="80" Margin="0,0,5,0" Click="OnRefreshProductsClick" />
                        <Button Content="Delete Selected Target" Width="150" Margin="0,0,5,0" Click="OnDeleteTargetClick" />
                        <TextBlock Text="New Threshold (AUD):" VerticalAlignment="Center" Margin="10,0,5,0" />
                        <TextBox x:Name="NewThresholdTextBox" Width="100" Margin="0,0,5,0" />
                        <Button Content="Update Threshold" Width="120" Click="OnUpdateThresholdClick" />
                    </StackPanel>

                    <DataGrid x:Name="ProductsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Target ID" Binding="{Binding TargetId}" Width="*" />
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="*" />
                            <DataGridTextColumn Header="Retailer" Binding="{Binding RetailerName}" Width="*" />
                            <DataGridTextColumn Header="URL" Binding="{Binding ProductPageUrl}" Width="3*" />
                            <DataGridTextColumn Header="Last Price" Binding="{Binding LastPrice}" Width="*" />
                            <DataGridTextColumn Header="Last Scraped (UTC)" Binding="{Binding LastScrapedAtUtc}" Width="2*" />
                            <DataGridTextColumn Header="Threshold (AUD)" Binding="{Binding ThresholdValue}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="History &amp; Errors">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,5">
                        <Button Content="Refresh History" Width="120" Margin="0,0,5,0" Click="OnRefreshHistoryClick" />
                        <Button Content="Delete Selected Scrape" Width="150" Margin="0,0,5,0" Click="OnDeleteScrapeClick" />
                        <Button Content="Delete Selected Error" Width="150" Click="OnDeleteErrorClick" />
                    </StackPanel>

                    <GroupBox Header="Recent Scrapes" Grid.Row="1" Margin="0,0,0,5">
                        <DataGrid x:Name="HistoryGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Scrape ID" Binding="{Binding Id}" Width="*" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Retailer" Binding="{Binding RetailerName}" Width="*" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*" />
                                <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="*" />
                                <DataGridTextColumn Header="Scraped (UTC)" Binding="{Binding ScrapedAtUtc}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Recent Errors" Grid.Row="3">
                        <DataGrid x:Name="ErrorsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Error ID" Binding="{Binding Id}" Width="*" />
                                <DataGridTextColumn Header="Target ID" Binding="{Binding ProductTargetId}" Width="*" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
                                <DataGridTextColumn Header="Exception" Binding="{Binding ExceptionType}" Width="2*" />
                                <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAtUtc}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

