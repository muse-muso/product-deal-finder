<Window x:Class="ProductDealFinder.ManageDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Manage Products and History" Height="620" Width="1020" MinHeight="400" MinWidth="700">
    <Grid Margin="16">
        <TabControl>
            <TabItem Header="Products &amp; Thresholds">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Width="100" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnRefreshProductsClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Width="160" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnDeleteTargetClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Delete Selected Target" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="New Threshold (AUD):" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="13" />
                        <TextBox x:Name="NewThresholdTextBox" Width="100" Margin="0,0,8,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <Button Width="130"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="OnUpdateThresholdClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Pencil" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Update Threshold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <materialDesign:Card UniformCornerRadius="6" Padding="0">
                        <DataGrid x:Name="ProductsGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target ID" Binding="{Binding TargetId}" Width="*" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="*" />
                                <DataGridTextColumn Header="Retailer" Binding="{Binding RetailerName}" Width="*" />
                                <DataGridTextColumn Header="URL" Binding="{Binding ProductPageUrl}" Width="3*" />
                                <DataGridTextColumn Header="Last Price" Binding="{Binding LastPrice}" Width="*" />
                                <DataGridTextColumn Header="Last Scraped (UTC)" Binding="{Binding LastScrapedAtUtc}" Width="2*" />
                                <DataGridTextColumn Header="Threshold (AUD)" Binding="{Binding ThresholdValue}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>
                </DockPanel>
            </TabItem>

            <TabItem Header="History &amp; Errors">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                        <Button Width="140" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnRefreshHistoryClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Refresh History" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Width="170" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnDeleteScrapeClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Delete Selected Scrape" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Width="170"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnDeleteErrorClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="DeleteSweep" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Delete Selected Error" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <materialDesign:Card Grid.Row="1" Margin="0,0,0,12" UniformCornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Recent Scrapes" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                            <DataGrid x:Name="HistoryGrid" Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Scrape ID" Binding="{Binding Id}" Width="*" />
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" />
                                    <DataGridTextColumn Header="Retailer" Binding="{Binding RetailerName}" Width="*" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="*" />
                                    <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="*" />
                                    <DataGridTextColumn Header="Scraped (UTC)" Binding="{Binding ScrapedAtUtc}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="3" UniformCornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Recent Errors" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                            <DataGrid x:Name="ErrorsGrid" Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Error ID" Binding="{Binding Id}" Width="*" />
                                    <DataGridTextColumn Header="Target ID" Binding="{Binding ProductTargetId}" Width="*" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
                                    <DataGridTextColumn Header="Exception" Binding="{Binding ExceptionType}" Width="2*" />
                                    <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAtUtc}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
